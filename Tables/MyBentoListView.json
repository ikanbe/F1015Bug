    "CreateViewSql": "SELECT\r\na.ID as CalendarID\r\n,b.BentoID\r\n,b.OrderPerson\r\n,c.BentoName\r\n,c.BentoPrice\r\n,c.BentoImage\r\nFROM\r\n  Calendar a\r\nLEFT OUTER JOIN\r\n  BentoOrder b\r\nON a.Calendar = b.OrderDate\r\nLEFT OUTER JOIN\r\n  Bento c\r\nON b.BentoID = c.ID"
