  "Values": {
    "1,1": "弁当注文者：",
    "2,2": "メニューの［弁当注文］から弁当を注文する画面に移動します。",
    "3,3": "弁当を注文したい日を選択し［注文］をクリックすることでお弁当を注文します。",
    "4,3": "注文後に表示される［変更、削除］リンクを選択し注文を変更します。",
    "5,3": "注文、および、注文の変更、削除は、前日までしかできません。",
    "6,2": "弁当を注文する画面には今月以降の注文状況が表示されます。",
    "7,2": "過去の注文状況は［注文履歴］から確認します。",
    "9,2": "モバイル注文",
    "10,3": "モバイルからは、弁当の注文、注文の確認と削除ができます。",
    "12,1": "総務（集計）担当者：",
    "13,2": "弁当注文者ができる操作はすべてできます。",
    "14,2": "管理メニューよりすべての弁当注文者の注文状況を確認できます。",
    "15,2": "注文日ごとの注文集計結果を確認できます。",
    "16,2": "月次の清算集計結果を確認できます。",
    "19,1": "初期化する方法：",
    "20,2": "テーブルの初期化",
    "21,2": "以下のテーブルについて「全レコードの削除とIDのリセット」を行うことで",
    "22,2": "データなしの状態から始められます。",
    "23,3": "「BentoOrder」、「Bento」",
    "25,2": "お弁当の種類と金額は以下のテーブルにあらかじめ設定します。",
    "26,3": "「Bento」",
    "28,2": "注文者、総務（集計）担当者",
    "29,3": "注文者の情報は、登録されているユーザーアカウントより取得しています。",
    "30,3": "ユーザーアカウントを登録／削除することで表示されるアカウントを編集できます。",
    "31,3": "集計担当者は、「soumu」ロールを設定すると「管理メニュー」にアクセスできます。",
    "33,2": "ログイン画面",
    "34,3": "本サンプルでは、ログインページをカスタマイズしてログインユーザーを表示していますが、",
    "35,3": "ビルトイン画面であるログインページはリセットが可能です。",
    "36,3": "右ペインの「ページ設定」よりリセットしてください。"
  },
