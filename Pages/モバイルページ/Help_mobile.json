  "Values": {
    "1,1": "弁当注文システム(モバイル)の使い方",
    "3,1": "ログイン画面に表示されるユーザーは全員弁当の注文が",
    "4,1": "可能です。",
    "6,1": "弁当の注文：",
    "7,2": "メニューの［弁当注文］から［注文する］を選択",
    "8,3": "弁当を注文したい日を選択",
    "9,3": "注文する弁当を選択",
    "10,3": "［注文を確定する］ボタンで注文します",
    "12,1": "弁当した弁当のキャンセル：",
    "13,2": "メニューの［弁当注文］から［注文履歴］を選択",
    "14,3": "キャンセルする日の［削除］ボタンから",
    "15,3": "キャンセルします",
    "17,1": "※注文済みの弁当を変更する場合は、注文を削除して",
    "18,2": "から再注文してください。"
  },
